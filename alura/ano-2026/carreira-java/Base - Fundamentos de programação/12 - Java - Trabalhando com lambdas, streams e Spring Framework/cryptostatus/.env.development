# =============================================================================
# Variáveis de Ambiente - ScreenMatch
# =============================================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=screenmatch

# Conexão com o banco (usado pelo Spring Boot)
# Nota: 'database' é o nome do serviço no Docker Compose
DATABASE_URL=postgresql://postgres:postgres@database:5432/screenmatch
SPRING_DATASOURCE_URL=jdbc:postgresql://database:5432/screenmatch
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Ambiente
SPRING_PROFILES_ACTIVE=dev
